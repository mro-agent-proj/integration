---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	classification_started(classification_started)
	investigation_started(investigation_started)
	review_started(review_started)
	classify(classify)
	investigate(investigate)
	review(review)
	direct(direct)
	finalize(finalize)
	hold(hold)
	increment(increment)
	limit(limit)
	completed(completed)
	__end__([<p>__end__</p>]):::last
	__start__ --> classification_started;
	classification_started --> classify;
	classify -.-> direct;
	classify -.-> hold;
	classify -. &nbsp;investigate&nbsp; .-> investigation_started;
	direct --> completed;
	finalize --> completed;
	hold --> completed;
	increment --> investigation_started;
	investigate --> review_started;
	investigation_started --> investigate;
	limit --> hold;
	review -.-> finalize;
	review -.-> hold;
	review -. &nbsp;retry&nbsp; .-> increment;
	review -.-> limit;
	review_started --> review;
	completed --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc

